<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- ============ barra superior: escudo/lupa + dirección + X + recargar ============
         La barra superior es el ancla del modo búsqueda (4.0): el texto
         tecleado en el buscador central vive SIEMPRE aquí, nunca lo tapa
         el teclado (windowSoftInputMode=adjustResize en el manifest). -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/btnShield"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:contentDescription="Bloqueos de anuncios en esta página"
            android:text="&#128737;"
            android:textColor="#212121"
            android:textSize="13sp" />

        <AutoCompleteTextView
            android:id="@+id/editUrl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Página de inicio"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingLeft="6dp"
            android:paddingRight="2dp"
            android:singleLine="true"
            android:textColor="#212121"
            android:textColorHint="#9E9E9E"
            android:textSize="15sp" />

        <!-- 4.7: expandir la URL a pantalla completa — aparece en modo
             edición cuando la URL no cabe en la barra (texto largo). -->
        <Button
            android:id="@+id/btnUrlExpand"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:contentDescription="Ver la URL completa a pantalla completa"
            android:text="&#8689;"
            android:textColor="#8A8A8A"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- botón X de limpieza: aparece en cuanto hay algo escrito -->
        <Button
            android:id="@+id/btnClear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:contentDescription="Borrar la búsqueda actual"
            android:text="&#10005;"
            android:textColor="#8A8A8A"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnReload"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:contentDescription="Recargar o detener la página"
            android:text="&#10227;"
            android:textColor="#212121"
            android:textSize="19sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/webProg"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="gone" />

    <!-- tira de pestañas antigua: OCULTA (el conmutador ahora es una hoja
         inferior); se conserva para no romper el código que la refresca -->
    <LinearLayout
        android:id="@+id/tabsRow"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/tabsStripScroll"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabsStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- contenedor del WebView de la pestaña activa -->
        <FrameLayout
            android:id="@+id/webHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ============ página de inicio (estilo Via Browser 4.0) ============
             4.2.3: eliminado el icono enorme (64dp) y la barra homeSearch
             que había debajo. Ambos eran redundantes: la barra superior
             (editUrl) ya hace la misma función. Sin ellos el panel de
             accesos directos gana todo el espacio vertical. -->
        <LinearLayout
            android:id="@+id/homeOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- título del panel de accesos activo + botón de edición -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="2dp"
                android:paddingRight="8dp">

                <TextView
                    android:id="@+id/txtSitesTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Sitios comunes"
                    android:textColor="#5A5A5A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 4.2.2: botón explícito para renombrar el panel (el
                     long-press sobre el título también funciona, pero no
                     era descubrible; este botón lo hace obvio). -->
                <Button
                    android:id="@+id/btnRenamePanel"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:contentDescription="Renombrar este panel"
                    android:minWidth="0dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="4dp"
                    android:text="✏"
                    android:textColor="#5A5A5A"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnEditSites"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:contentDescription="Editar accesos directos"
                    android:minWidth="0dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Editar"
                    android:textColor="#5A5A5A"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- paneles de accesos: swipe horizontal entre páginas,
                 scroll vertical interno cuando desbordan -->
            <HorizontalScrollView
                android:id="@+id/sitesPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/sitesPages"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/sitesDots"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp">

                <Button
                    android:id="@+id/btnAddSite"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="&#10133; Añadir sitio"
                    android:textColor="#5A5A5A"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnResetSites"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Restaurar"
                    android:textColor="#5A5A5A"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ sugerencias al escribir (marcadores/historial) ============
             Lista desplazable hasta el final (4.0): nunca más sin scroll -->
        <LinearLayout
            android:id="@+id/suggestionsHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ListView
                android:id="@+id/suggestionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="#EEEEEE"
                android:dividerHeight="1dp"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- ============ FAB de descargas detectadas (4.0) ============
             Aparece en cuanto se detecta un elemento descargable en la
             pestaña activa; muestra el contador en tiempo real. -->
        <Button
            android:id="@+id/btnDetectFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/fab_bg"
            android:elevation="8dp"
            android:minWidth="0dp"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="&#9654; 0"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============ hoja inferior: conmutador de pestañas ============ -->
    <LinearLayout
        android:id="@+id/tabSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tabListHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnNewTab"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:contentDescription="Nueva pestaña"
            android:text="&#65291;"
            android:textColor="#212121"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- ============ hoja inferior: menú con PÁGINAS DESLIZABLES (4.0) ============
         El swipe izquierda/derecha cambia de página de opciones; los puntos
         de abajo reflejan (y permiten saltar a) la página activa. -->
    <LinearLayout
        android:id="@+id/menuSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/menuPager"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menuPages"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/menuDots"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMenuExit"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:contentDescription="Salir de TurboDL"
                android:text="&#128268;"
                android:textColor="#212121"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnMenuCollapse"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:contentDescription="Cerrar el menú"
                android:text="&#8964;"
                android:textColor="#212121"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ barra inferior de navegación (estilo 4.0) ============ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Atrás"
            android:text="&#8249;"
            android:textColor="#212121"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnFwd"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Adelante"
            android:text="&#8250;"
            android:textColor="#212121"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnHome"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Inicio"
            android:text="&#8962;"
            android:textColor="#212121"
            android:textSize="20sp" />

        <!-- 4.13: botón "App" — volver al MENÚ PRINCIPAL de TurboDL
             (MainActivity) desde el navegador. Antes (4.2.3–4.12) este
             botón solo mostraba la vista de accesos DENTRO del navegador
             (icono ▖, imposible de distinguir de btnHome ⌂ — reportado).
             Ahora cierra el navegador y abre el menú principal; las
             pestañas se persisten antes de salir y se restauran al
             reabrir el navegador. -->
        <Button
            android:id="@+id/btnMainHome"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Volver al menú principal de TurboDL"
            android:text="App"
            android:textStyle="bold"
            android:textColor="#212121"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnTabCount"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Conmutador de pestañas"
            android:text="[1]"
            android:textColor="#212121"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnMore"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Menú del navegador"
            android:text="&#9776;"
            android:textColor="#212121"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- celdas compatibles (se actualizan por código; visibles dentro del menú) -->
    <Button
        android:id="@+id/btnVideos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnDesk"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
