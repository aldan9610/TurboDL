<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- barra superior con menu lateral y menu de opciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btnMenu"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="&#9776;"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TurboDL"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listo"
                android:textColor="#FFE0B2"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMore"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="&#8942;"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp" />

        <!-- cajon lateral -->
        <View
            android:id="@+id/dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/drawer"
            android:layout_width="270dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?android:attr/colorBackground"
            android:elevation="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TurboDL"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descargas multipropósito"
                    android:textColor="#FFE0B2"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dNav"
                style="@style/DrawerItem"
                android:text="&#127760;  Navegador" />

            <TextView
                android:id="@+id/dAdd"
                style="@style/DrawerItem"
                android:text="&#10133;  Añadir descarga" />

            <TextView
                android:id="@+id/dResume"
                style="@style/DrawerItem"
                android:text="&#9654;  Reanudar todo" />

            <TextView
                android:id="@+id/dPause"
                style="@style/DrawerItem"
                android:text="&#10074;&#10074;  Pausar todo" />

            <TextView
                android:id="@+id/dSort"
                style="@style/DrawerItem"
                android:text="&#8597;  Ordenar lista" />

            <TextView
                android:id="@+id/dTools"
                style="@style/DrawerItem"
                android:text="&#128295;  Herramientas" />

            <TextView
                android:id="@+id/dSettings"
                style="@style/DrawerItem"
                android:text="&#9881;  Ajustes" />

            <TextView
                android:id="@+id/dExit"
                style="@style/DrawerItem"
                android:text="&#10005;  Salir (cerrar del todo)" />
        </LinearLayout>
    </FrameLayout>

    <!-- barra inferior de acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bar"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/btnAdd"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="&#10133; Añadir"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnBrowser"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Navegador"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAll"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="&#9654; Todo"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
