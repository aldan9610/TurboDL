<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exención de optimización de batería: se solicita en la introducción
         (estilo 1DM) para que Android no pare las descargas en segundo plano -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Se solicitan en tiempo de ejecución solo en Android 6..9 cuando el
         usuario elige guardar fuera de la carpeta de la app -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Auto-actualización desde GitHub Releases (instalación de APK oficial) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 4.1: características opcionales declaradas como NO requeridas, para que
         la app se instale también en tablets sin teléfono/cámara/GPS. Sin
         esto, Google Play filtra el APK por hardware en algunos fabricantes. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 4.1: gestor de descargas externo — otras apps comparten un
                 enlace (ACTION_SEND con texto) y TurboDL aparece en el
                 chooser. Es la vía estándar para "Compartir enlace" desde
                 cualquier navegador, red social o lector de QR. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 4.1: la app también aparece en el chooser de enlaces
                 http/https como GESTOR DE DESCARGAS (junto al navegador
                 BrowserActivity). El usuario decide: "Abrir en TurboDL"
                 (esta Activity) lo añade a la cola de descargas; "Abrir en
                 navegador" (BrowserActivity) lo abre. Igual que 1DM/Gopeed. -->
            <intent-filter
                android:label="@string/app_full"
                android:icon="@mipmap/ic_launcher"
                android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Abrir magnet / torrent desde otras apps: van a la cola -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
        </activity>

        <!-- 4.1: BrowserActivity ahora es EXPORTED y declara intent-filters
             para que el sistema Android la reconozca como NAVEGADOR
             disponible (categoría APP_BROWSER + BROWSABLE + http/https).
             Aparece en Ajustes > Apps > Aplicaciones predeterminadas >
             Navegador, y al tocar un enlace http/https en cualquier app
             el usuario puede elegirla. -->
        <activity
            android:name=".ui.BrowserActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <!-- Navegador del sistema: al tocar un enlace http/https en
                 Gmail, WhatsApp, Keep Notes… el chooser ofrece TurboDL
                 junto a Chrome/Firefox. Si el usuario la elige "Siempre",
                 se convierte en el navegador por defecto del teléfono. -->
            <intent-filter
                android:label="@string/app_name"
                android:icon="@mipmap/ic_launcher">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.APP_BROWSER" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Recibir URLs compartidas desde otras apps: igual que
                 MainActivity, pero abre la URL en el navegador en lugar de
                 mandarla a la cola. Permite "Compartir enlace → Abrir en
                 navegador TurboDL". -->
            <intent-filter
                android:label="@string/app_name"
                android:icon="@mipmap/ic_launcher">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Búsqueda web desde el asistente de Google / búsqueda por voz:
                 "Buscar X" abre el navegador TurboDL con la búsqueda. -->
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Texto plano seleccionado en otra app → "Abrir en TurboDL"
                 (igual que "Buscar en Google"). -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ToolsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.VideoActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <activity
            android:name=".ui.LockActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false" />

        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name=".provider.MiniFileProvider"
            android:authorities="com.turbodl.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
