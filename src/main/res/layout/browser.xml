<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- ============ barra superior: escudo/lupa + dirección + recargar ============ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/btnShield"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:contentDescription="Bloqueos de anuncios en esta página"
            android:text="&#128737;"
            android:textColor="#212121"
            android:textSize="13sp" />

        <AutoCompleteTextView
            android:id="@+id/editUrl"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Página de inicio"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:singleLine="true"
            android:textColor="#212121"
            android:textColorHint="#9E9E9E"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnGo"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnReload"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:contentDescription="Recargar o detener la página"
            android:text="&#10227;"
            android:textColor="#212121"
            android:textSize="19sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/webProg"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="gone" />

    <!-- tira de pestañas antigua: OCULTA (el conmutador ahora es una hoja
         inferior); se conserva para no romper el código que la refresca -->
    <LinearLayout
        android:id="@+id/tabsRow"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/tabsStripScroll"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabsStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- contenedor del WebView de la pestaña activa -->
        <FrameLayout
            android:id="@+id/webHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ============ página de inicio (estilo navegador 4.0) ============ -->
        <LinearLayout
            android:id="@+id/homeOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="56dp">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:contentDescription="TurboDL"
                    android:src="@mipmap/ic_launcher" />

                <EditText
                    android:id="@+id/homeSearch"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginLeft="28dp"
                    android:layout_marginTop="36dp"
                    android:layout_marginRight="28dp"
                    android:background="@drawable/pill_bg"
                    android:hint="Buscar o escribir dirección"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:paddingLeft="22dp"
                    android:paddingRight="22dp"
                    android:singleLine="true"
                    android:textColor="#212121"
                    android:textColorHint="#9E9E9E"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="18dp"
                android:paddingTop="26dp"
                android:paddingBottom="2dp"
                android:text="Accesos directos  (mantén pulsado para quitar)"
                android:textColor="#8A8A8A"
                android:textSize="11sp" />

            <GridView
                android:id="@+id/gridSites"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:horizontalSpacing="6dp"
                android:numColumns="4"
                android:padding="8dp"
                android:verticalSpacing="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp">

                <Button
                    android:id="@+id/btnAddSite"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="&#10133; Añadir sitio"
                    android:textColor="#5A5A5A"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnResetSites"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Restaurar"
                    android:textColor="#5A5A5A"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ sugerencias al escribir (marcadores/historial) ============ -->
        <LinearLayout
            android:id="@+id/suggestionsHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============ hoja inferior: conmutador de pestañas ============ -->
    <LinearLayout
        android:id="@+id/tabSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tabListHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnNewTab"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:contentDescription="Nueva pestaña"
            android:text="&#65291;"
            android:textColor="#212121"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- ============ hoja inferior: menú (cuadrícula paginada) ============ -->
    <ScrollView
        android:id="@+id/menuSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sheet_bg"
        android:elevation="12dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp">

            <GridLayout
                android:id="@+id/menuGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="5"
                android:paddingLeft="6dp"
                android:paddingRight="6dp" />

            <LinearLayout
                android:id="@+id/menuDots"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMenuExit"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="52dp"
                    android:layout_height="44dp"
                    android:contentDescription="Salir de TurboDL"
                    android:text="&#128268;"
                    android:textColor="#212121"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnMenuCollapse"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="52dp"
                    android:layout_height="44dp"
                    android:contentDescription="Cerrar el menú"
                    android:text="&#8964;"
                    android:textColor="#212121"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ============ barra inferior de navegación (estilo 4.0) ============ -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Atrás"
            android:text="&#8249;"
            android:textColor="#212121"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnFwd"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Adelante"
            android:text="&#8250;"
            android:textColor="#212121"
            android:textSize="22sp" />

        <Button
            android:id="@+id/btnHome"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Inicio"
            android:text="&#8962;"
            android:textColor="#212121"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnTabCount"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Conmutador de pestañas"
            android:text="[1]"
            android:textColor="#212121"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnMore"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Menú del navegador"
            android:text="&#9776;"
            android:textColor="#212121"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- celdas compatibles (se actualizan por código; visibles dentro del menú) -->
    <Button
        android:id="@+id/btnVideos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnDesk"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
